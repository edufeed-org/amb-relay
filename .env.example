NAME="AMB Relay (local)"
PUBKEY=""
DESCRIPTION="Local development AMB relay"
ICON=""

# Public-facing URL (set when behind a reverse proxy to fix NIP-98 auth).
# Clients signing NIP-98 auth events must put this URL in their "u" tag —
# anything else is rejected as a u-tag mismatch. If amb-indexer reaches the
# relay over a private network (e.g. http://relay:3334/ inside docker), set
# RELAY_NIP86_AUTH_URL on the indexer to match THIS value while leaving
# RELAY_NIP86_URL pointed at the private address.
# SERVICE_URL=wss://your-relay.example.com
TS_APIKEY="xyz"
TS_HOST="http://localhost:8108"
TS_COLLECTION="amb-local"
DB_PATH="./data/relay.db"

# Long-form (NIP-23 kind-30023) support (optional). When enabled, the relay
# also accepts kind-30023 events (requiring d + title tags) and indexes their
# structured fields into a SEPARATE Typesense collection, keeping the AMB
# collection pristine. The search path merges both collections by kind.
LONGFORM_ENABLED="false"
# Collection name for the long-form structured fields (default longform_30023).
TS_COLLECTION_LONGFORM="longform_30023"
# Wiki (NIP-54 kind-30818) support (optional). When enabled, the relay also
# accepts kind-30818 events (requiring a d tag; title optional) and indexes
# their structured fields into a SEPARATE Typesense collection. The search path
# merges all enabled collections by kind.
WIKI_ENABLED="false"
# Collection name for the wiki structured fields (default wiki_30818).
TS_COLLECTION_WIKI="wiki_30818"
# Comma-separated hex pubkeys with full NIP-86 admin access (in addition to PUBKEY).
# Include the amb-indexer service's pubkey here if running the fulltext indexer.
ADMIN_PUBKEYS=""

# Semantic search (optional). The default URL targets the in-stack embed
# service defined in docker-compose.yml; override if you point at a different
# embedding endpoint.
EMBED_ENDPOINT="http://embed:8100/embed"
EMBED_TOKEN=""
SEMANTIC_SEARCH_ENABLED="false"  # Set to "true" to auto-enable on startup

# Chunk re-ranking (optional). When enabled, NIP-50 searches are re-ranked by
# the best matching fulltext passage from amb-indexer's chunk index
# (POST /search_chunks). Requires the amb-indexer service; the relay falls
# back to plain Typesense search whenever the indexer errors or returns
# nothing. INDEXER_API_TOKEN must match the value in
# ../amb-indexer/.env.indexer.
CHUNK_RERANK_ENABLED="false"
# INDEXER_BASE_URL="http://amb-indexer:8080"
INDEXER_API_TOKEN=""

# Snippet signing key (optional, hex secret key). Signs the ephemeral
# kind-21142 search-snippet events that opted-in clients receive alongside
# chunk-reranked results (kinds:[30142,21142] + search). MUST be a dedicated
# key for this relay — never an operator/personal key. When unset, a fresh
# key is generated at startup (snippets stay validly signed, the signer
# pubkey just changes across restarts; it is printed in the startup log).
# RELAY_SECKEY=""
